# 이 파일을 복사해서 .env로 저장한 뒤 실제 값으로 채우세요.
# .env는 .gitignore에 포함되어 있어 절대 커밋되지 않습니다.

# 토스증권 Open API (설정 > Open API 메뉴에서 발급)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=https://openapi.tossinvest.com

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 로컬 SQLite DB 경로
ASSETPILOT_DB_PATH=data/assetpilot.db
