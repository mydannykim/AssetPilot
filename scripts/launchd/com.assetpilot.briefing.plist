<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.assetpilot.briefing</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/kimseonghyun/AssetPilot/scripts/launchd/run_briefing.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/kimseonghyun/AssetPilot</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>16</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <!-- 국내장 시간(09:00~15:30) 중 3시간 간격으로 장중 갱신. 스냅샷(토스 API만 사용,
             Claude 사용량과 무관)은 1시간마다 그대로 돌지만, 여긴 헤드리스 claude -p로
             Claude Pro 사용량을 쓰기 때문에 빈도를 낮게 유지한다. -->
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>15</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/kimseonghyun/AssetPilot/data/briefing.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kimseonghyun/AssetPilot/data/briefing.error.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
